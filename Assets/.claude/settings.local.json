{
    "permissions": {
        "allow": [
            "Bash(wc -l C:RepositoriesFishOWisp2AssetsScripts/**/*.cs)",
            "Bash(find . -name \"*.cs\" -exec wc -l {})",
            "Bash(grep -l DontDestroyOnLoad /c/Repositories/FishOWisp2/Assets/Scripts/**/*.cs)",
            "Bash(find C:RepositoriesFishOWisp2AssetsREFLECT -type f -name *.cs)",
            "Bash(find C:RepositoriesFishOWisp2Assets -type f -name *Post* -o -name *post*)",
            "Bash(find C:RepositoriesFishOWisp2Assets -type f -name *FullScreen*)",
            "Bash(xargs grep:*)",
            "Bash(find C:RepositoriesFishOWisp2AssetsScripts -type f -name *Renderer*.cs -o -name *Render*.cs)",
            "Bash(grep -r \"ScriptableRenderPass\\\\|ScriptableRendererFeature\" C:RepositoriesFishOWisp2AssetsScripts --include=*.cs)",
            "Bash(find /c/Repositories/FishOWisp2/Library/PackageCache/com.unity.render-pipelines.universal* -name \"*.cs\")",
            "Read(//c/Repositories/FishOWisp2/Packages/**)",
            "Read(//c/Repositories/FishOWisp2/Library/**)"
        ]
    }
}

{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 -c \"import sys, json; cmd = json.load(sys.stdin).get('tool_input', {}).get('command', ''); exit(1 if 'git worktree add' in cmd else 0)\""
                    }
                ]
            }
        ]
    }
}