{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "71761f55b61a409d84437473edbb2627",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Kuwahara (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1617.0,
            "y": 51.000003814697269,
            "width": 211.0,
            "height": 190.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b31f7fb159834fce8a6d87362f5c7f4e"
        },
        {
            "m_Id": "285f7f3e97564dae8e5f76378327dc8a"
        },
        {
            "m_Id": "724d4883ab6e48b98db91023142afbd9"
        },
        {
            "m_Id": "55c307403d964463bb9b85cad70ccdc1"
        },
        {
            "m_Id": "f0a756e14b794060b4ea700641821bc2"
        },
        {
            "m_Id": "4668bba30d644643a29541c452b4f06e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Kuwahara",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// HLSL Kuwahara Implementation\nint radius = (int)Radius;\nfloat n = float((radius + 1) * (radius + 1));\nfloat3 means[4];\nfloat3 vars[4];\n\n// Init arrays\nfor (int i = 0; i < 4; i++) {\n    means[i] = float3(0, 0, 0);\n    vars[i] = float3(0, 0, 0);\n}\n\n// Loop through 4 quadrants\nfor (int x = -radius; x <= radius; x++) {\n    for (int y = -radius; y <= radius; y++) {\n        float2 offset = float2(x, y) * TexelSize;\n        float3 color = SAMPLE_TEXTURE2D(Tex, SS, UV + offset).rgb;\n\n        // Quadrant Logic\n        if (x <= 0 && y <= 0) { means[0] += color; vars[0] += color * color; }\n        if (x >= 0 && y <= 0) { means[1] += color; vars[1] += color * color; }\n        if (x <= 0 && y >= 0) { means[2] += color; vars[2] += color * color; }\n        if (x >= 0 && y >= 0) { means[3] += color; vars[3] += color * color; }\n    }\n}\n\nfloat minVar = 10000.0;\nfloat3 finalColor = float3(0, 0, 0);\n\nfor (int j = 0; j < 4; j++) {\n    means[j] /= n;\n    vars[j] = abs(vars[j] / n - means[j] * means[j]);\n    float totalVar = vars[j].r + vars[j].g + vars[j].b;\n\n    if (totalVar < minVar) {\n        minVar = totalVar;\n        finalColor = means[j];\n    }\n}\n\nOut = finalColor;"
}

